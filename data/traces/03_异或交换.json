    "algo": "03_异或交换",
    "source_lines": [
      "#include <stdio.h>",
      "#include <stdlib.h>",
      "#include <string.h>",
      "/* 不使用临时变量，交换a和b的值 */",
      "/* 利用异或的性质：a ^ a = 0, a ^ 0 = a */",
      "/* 类比：两个人交换礼物，用纸箱中转——先放进去，再拿出来 */",
      "void swap(int *a, int *b) {",
      "    if (a == b) return;  /* 防止同一个地址异或自己变成0 */",
      "    *a = *a ^ *b;       /* 第1步：a变成\"a和b的异或值\" */",
      "    *b = *a ^ *b;       /* 第2步：b = (a^b) ^ b = a，b拿到了原来的a */",
      "    *a = *a ^ *b;       /* 第3步：a = (a^b) ^ a = b，a拿到了原来的b */",
      "}",
      "/* ===== 自动生成的测试入口 ===== */",
      "int main() {",
      "    int a = 5;",
      "    int b = 3;",
      "    printf(\"交换前：a=%d, b=%d\\n\", a, b);",
      "    swap(&a, &b);",
      "    printf(\"交换后：a=%d, b=%d\\n\", a, b);",
      "    return 0;",
      "}"
    ],
