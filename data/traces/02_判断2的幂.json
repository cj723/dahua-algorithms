  "meta": {
    "algo": "02_判断2的幂",
    "source_lines": [
      "#include <stdio.h>",
      "#include <stdlib.h>",
      "#include <string.h>",
      "/* 判断正整数n是否是2的幂 */",
      "/* 思路：2的幂只有一个1，n & (n-1)应该等于0 */",
      "/* 类比：2的幂就像独行侠——只携带一个\"1\" */",
      "int is_power_of_two(unsigned int n) {",
      "    return n != 0 && ((n & (n - 1)) == 0);",
      "}",
      "// 测试：判断一个数是否是 2 的幂",
      "int main() {",
      "    printf(\"判断依据：2的幂的二进制只有一个1，n & (n-1) == 0\\n\\n\");",
      "    printf(\"is_power_of_two(1)  = %d （0b1）\\n\", is_power_of_two(1));",
      "    printf(\"is_power_of_two(2)  = %d （0b10）\\n\", is_power_of_two(2));",
      "    printf(\"is_power_of_two(8)  = %d （0b1000）\\n\", is_power_of_two(8));",
      "    printf(\"is_power_of_two(10) = %d （0b1010——不是2的幂）\\n\", is_power_of_two(10));",
      "    printf(\"is_power_of_two(0)  = %d （0不是2的幂）\\n\", is_power_of_two(0));",
      "    return 0;",
      "}"
    ],
