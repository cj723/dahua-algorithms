    "algo": "04_位图_Bitmap",
    "source_lines": [
      "/* 位图(Bitmap)实现 */",
      "/* 类比：出勤点名册——每个学生一个格子，来了打勾 */",
      "#include <stdio.h>",
      "#include <stdlib.h>",
      "#include <string.h>",
      "#define MAX_NUM 1000000  /* 最大能存储的数 */",
      "/* 位图结构 */",
      "typedef struct {",
      "    unsigned char *bits;  /* 位图数组，每个char有8个bit */",
      "    int size;             /* 数组大小(字节数) */",
      "    int max;              /* 允许存储的最大数值 */",
      "} Bitmap;",
      "/* 创建位图 */",
      "/* 参数max:能存储的最大数值（允许下标为0..max，共 max+1 个bit） */",
      "Bitmap* bitmap_create(int max) {",
      "    if (max < 0) {",
      "        return NULL;",
      "    }",
      "    Bitmap *bm = (Bitmap *)malloc(sizeof(Bitmap));  /* 分配结构体内存 */",
      "    if (bm == NULL) {",
      "        printf(\"位图结构体内存分配失败\\n\");",
      "        return NULL;",
      "    }",
      "    /* 需要的字节数 = 能存 max+1 个bit，向上取整 = (max >> 3) + 1 */",
      "    /* 例如：max=7 需要1字节(能存0-7共8个bit) */",
      "    /*       max=8 需要2字节(能存0-15共16个bit，其中0-8是有效范围) */",
      "    bm->size = (max >> 3) + 1;",
      "    bm->max = max;",
      "    /* 分配位图数组，calloc会自动初始化为0 */",
      "    bm->bits = (unsigned char *)calloc(bm->size, sizeof(unsigned char));",
      "    if (bm->bits == NULL) {",
      "        printf(\"位图数组内存分配失败\\n\");",
      "        free(bm);",
      "        return NULL;",
      "    }",
      "    return bm;",
      "}",
      "/* 设置第n个bit为1(标记n存在) */",
      "/* 参数bm:位图指针;参数n:要标记的数值 */",
      "void bitmap_set(Bitmap *bm, int n) {",
      "    if (bm == NULL || n < 0 || n > bm->max) return;",
      "    int index = n >> 3;        /* n / 8，找到在第几个字节 */",
      "    int offset = n & 7;        /* n % 8，找到在第几个bit位 */",
      "    bm->bits[index] |= (1U << offset);  /* 把对应bit置为1 */",
      "    /* 1U << offset:生成一个只有第offset位是1的无符号数 */",
      "    /* |=:或操作，把目标bit设为1，不影响其他bit */",
      "}",
      "/* 检查第n个bit是否为1(检查n是否存在) */",
      "int bitmap_get(Bitmap *bm, int n) {",
      "    if (bm == NULL || n < 0 || n > bm->max) return 0;",
      "    int index = n >> 3;        /* n / 8 */",
      "    int offset = n & 7;        /* n % 8 */",
      "    return (bm->bits[index] & (1U << offset)) != 0;",
      "    /* & 操作：如果对应bit是1，结果非0;是0，结果为0 */",
      "}",
      "/* 清除第n个bit(标记n不存在) */",
      "void bitmap_clear(Bitmap *bm, int n) {",
      "    if (bm == NULL || n < 0 || n > bm->max) return;",
      "    int index = n >> 3;        /* n / 8 */",
      "    int offset = n & 7;        /* n % 8 */",
      "    bm->bits[index] &= ~(1U << offset);  /* 把对应bit清零 */",
      "    /* ~ (1U << offset):生成一个只有第offset位是0的无符号数 */",
      "    /* &=:与操作，把目标bit清0，不影响其他bit */",
      "}",
      "/* 释放位图内存 */",
      "void bitmap_destroy(Bitmap *bm) {",
      "    if (bm == NULL) return;",
      "    free(bm->bits);   /* 先释放bits数组 */",
      "    free(bm);         /* 再释放结构体 */",
      "}",
      "/* 测试代码 */",
      "int main() {",
      "    Bitmap *bm = bitmap_create(MAX_NUM);  /* 创建一个能存100万个数的位图 */",
      "    if (bm == NULL) {",
      "        return 1;",
      "    }",
      "    /* 模拟出勤记录：学号1、5、100、999999来了 */",
      "    bitmap_set(bm, 1);",
      "    bitmap_set(bm, 5);",
      "    bitmap_set(bm, 100);",
      "    bitmap_set(bm, 999999);",
      "    /* 检查出勤情况 */",
      "    printf(\"学号1来了吗？%s\\n\", bitmap_get(bm, 1) ? \"来了\" : \"没来\");",
      "    printf(\"学号2来了吗？%s\\n\", bitmap_get(bm, 2) ? \"来了\" : \"没来\");",
      "    printf(\"学号5来了吗？%s\\n\", bitmap_get(bm, 5) ? \"来了\" : \"没来\");",
      "    printf(\"学号999999来了吗？%s\\n\", bitmap_get(bm, 999999) ? \"来了\" : \"没来\");",
      "    bitmap_destroy(bm);  /* 释放内存 */",
      "    return 0;",
      "}"
    ],
